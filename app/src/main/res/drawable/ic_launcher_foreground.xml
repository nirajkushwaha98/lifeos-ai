<?xml version="1.0" encoding="utf-8"?>
<!--
  LifeOS AI launcher icon - foreground layer (108x108dp adaptive canvas; content stays inside
  the 66dp safe zone). A neon hexagon "AI core": broken hexagon frame with two circuit nodes,
  a tilted orbit that threads through the nodes (back half behind the core, front half in front),
  a glowing four-point spark and a small companion sparkle.
  Also used as the splash-screen icon and the in-app logo.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Ambient glow -->
    <path android:pathData="M22,54a32,32 0 1,1 64,0a32,32 0 1,1 -64,0z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="32">
                <item android:offset="0" android:color="#708B5CF6" />
                <item android:offset="0.55" android:color="#303B82F6" />
                <item android:offset="1" android:color="#003B82F6" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Orbit, back half (passes behind the core) -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="-30">
        <path
            android:pathData="M30,54A24,8 0 0,1 78,54"
            android:strokeWidth="1.2"
            android:strokeColor="#6622D3EE"
            android:strokeLineCap="round" />
    </group>

    <!-- Hexagon frame (two segments, broken at the circuit nodes) -->
    <path
        android:pathData="M32.35,62L32.35,41.5L54,29L71.75,39.25M75.65,46L75.65,66.5L54,79L36.25,68.75"
        android:strokeWidth="3.2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="32"
                android:startY="29"
                android:endX="76"
                android:endY="79">
                <item android:offset="0" android:color="#FF22D3EE" />
                <item android:offset="0.5" android:color="#FF3B82F6" />
                <item android:offset="1" android:color="#FF8B5CF6" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Circuit node glows -->
    <path android:pathData="M70.65,41.5a5,5 0 1,1 10,0a5,5 0 1,1 -10,0z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="75.65"
                android:centerY="41.5"
                android:gradientRadius="5">
                <item android:offset="0" android:color="#9922D3EE" />
                <item android:offset="1" android:color="#0022D3EE" />
            </gradient>
        </aapt:attr>
    </path>
    <path android:pathData="M27.35,66.5a5,5 0 1,1 10,0a5,5 0 1,1 -10,0z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="32.35"
                android:centerY="66.5"
                android:gradientRadius="5">
                <item android:offset="0" android:color="#99A78BFA" />
                <item android:offset="1" android:color="#00A78BFA" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Core glow -->
    <path android:pathData="M40,54a14,14 0 1,1 28,0a14,14 0 1,1 -28,0z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="14">
                <item android:offset="0" android:color="#B322D3EE" />
                <item android:offset="0.5" android:color="#3322D3EE" />
                <item android:offset="1" android:color="#0022D3EE" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- AI spark (core) -->
    <path android:pathData="M54,39Q56.6,51.4 65,54Q56.6,56.6 54,69Q51.4,56.6 43,54Q51.4,51.4 54,39Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="15">
                <item android:offset="0" android:color="#FFFFFFFF" />
                <item android:offset="0.25" android:color="#FFCFFAFE" />
                <item android:offset="0.55" android:color="#FF67E8F9" />
                <item android:offset="1" android:color="#FF3B82F6" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Orbit, front half, with a satellite -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="-30">
        <path
            android:pathData="M78,54A24,8 0 0,1 30,54"
            android:strokeWidth="1.6"
            android:strokeColor="#E622D3EE"
            android:strokeLineCap="round" />
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M33.91,59.14a1.7,1.7 0 1,1 3.4,0a1.7,1.7 0 1,1 -3.4,0z" />
    </group>

    <!-- Circuit nodes (on top, where the orbit meets the frame) -->
    <path
        android:fillColor="#FF22D3EE"
        android:pathData="M73.35,41.5a2.3,2.3 0 1,1 4.6,0a2.3,2.3 0 1,1 -4.6,0z" />
    <path
        android:fillColor="#FFA78BFA"
        android:pathData="M30.05,66.5a2.3,2.3 0 1,1 4.6,0a2.3,2.3 0 1,1 -4.6,0z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M74.75,41.5a0.9,0.9 0 1,1 1.8,0a0.9,0.9 0 1,1 -1.8,0zM31.45,66.5a0.9,0.9 0 1,1 1.8,0a0.9,0.9 0 1,1 -1.8,0z" />

    <!-- Companion sparkle -->
    <path
        android:fillColor="#FFE9D5FF"
        android:pathData="M72.5,26.7Q73.2,29.8 76.3,30.5Q73.2,31.2 72.5,34.3Q71.8,31.2 68.7,30.5Q71.8,29.8 72.5,26.7Z" />
</vector>
